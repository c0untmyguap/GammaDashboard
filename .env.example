# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by git — never commit real keys.

# Optional: require a password for the whole site (any username)
APP_PASSWORD=

# Options data source: auto (Schwab when signed in, otherwise CBOE delayed), schwab, or cboe
DATA_PROVIDER=auto

# Schwab Trader API (developer.schwab.com → your app → App Key / Secret)
# The callback must match the one registered on your Schwab app exactly.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK=https://127.0.0.1
